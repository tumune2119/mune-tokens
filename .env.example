# Copy this file to .env.local and fill in your key, then restart MUNE TOKENS.
# Optional: without a key, MUNE TOKENS uses the Claude Code CLI (your Claude subscription) instead.
ANTHROPIC_API_KEY=

# Optional: store the database somewhere else (default: ./data/mune-tokens.db)
# MUNE_TOKENS_DB_PATH=C:\Users\you\Documents\MUNE Tokens\mune-tokens.db
